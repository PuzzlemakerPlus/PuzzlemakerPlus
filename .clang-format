---
# microsoft style seems closest to what we were using previously
BasedOnStyle: Microsoft

# use tabs for indentation, not spaces
UseTab:          ForIndentation
AccessModifierOffset: -1

# align * and & to the type instead of the name
PointerAlignment: Left

# enforce spacing between functions for readability
SeparateDefinitionBlocks: Always

# adding these to avoid messing too much with existing formatting in certain places, might change later
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline

# sort includes by main include > std/library includes > PMP includes
IncludeBlocks: Regroup
IncludeIsMainRegex: '$?'
IncludeCategories:
  - Regex: '^<.*>'
    Priority: 1
  - Regex: '^".*"'
    Priority: 2

# everything is under PMP, so don't indent unless namespaces are nested
NamespaceIndentation: Inner

# stop git clients from bugging us about "no newline at end of file"
InsertNewlineAtEOF: true
